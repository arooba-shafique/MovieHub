{
  "buildCommand": "bash build.sh",
  "outputDirectory": ".",
  "framework": null,
  "installCommand": "pip install --break-system-packages -r requirements.txt",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/movie_project/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
